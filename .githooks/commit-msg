#!/bin/sh
# Локальный guardrail: проверяет сообщение коммита до его создания.
# Полные правила — scripts/check_commits.py и CI job "Commit messages".

set -u

msg_file=${1:-}
if [ -z "$msg_file" ]; then
    exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
checker="$root/scripts/check_commits.py"

run_python() {
    if command -v mise >/dev/null 2>&1; then
        mise exec -- python "$checker" --message-file "$msg_file"
        return $?
    fi
    if command -v uv >/dev/null 2>&1; then
        uv run --project "$root/backend" python "$checker" --message-file "$msg_file"
        return $?
    fi
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1; then
            "$candidate" "$checker" --message-file "$msg_file"
            return $?
        fi
    done
    return 127
}

run_python
status=$?

if [ "$status" -eq 127 ]; then
    # Fallback без Python: проверяем заголовок и ссылку на тикет.
    subject=$(sed -n '1p' "$msg_file")
    case "$subject" in
        "Merge "* | 'Revert "'* | "chore(main): release "*) exit 0 ;;
    esac

    pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._-]+\))?!?: .+ \(#[0-9]+\)$'
    if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
        exit 0
    fi

    echo "commit-msg: header must be Conventional Commits with a ticket reference (#N)" >&2
    echo "  message: $subject" >&2
    exit 1
fi

exit "$status"
