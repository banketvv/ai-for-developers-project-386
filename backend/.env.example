# Приложение
APP_NAME="Call Scheduler"
ENVIRONMENT=local
DEBUG=false

# База данных (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Единственный владелец календаря
OWNER_NAME="Владелец календаря"
OWNER_EMAIL=owner@example.com
OWNER_TIMEZONE=Europe/Moscow

# Cookie, которой сервис опознаёт смотрящего (гостя или владельца)
SESSION_COOKIE_NAME=guest_email
SESSION_COOKIE_MAX_AGE=2592000

# CORS: список origin'ов через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
